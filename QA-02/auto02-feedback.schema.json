{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/qa02/auto02-feedback.schema.json",
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        "task_id": {
          "type": "string",
          "pattern": "^task_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        }
      },
      "required": [
        "project_id",
        "task_id",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^spec_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "spec_id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^art_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/plain",
            "application/octet-stream"
          ]
        },
        "aggregate_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "project_id",
        "artifact_id",
        "content_hash",
        "bytes",
        "media_type",
        "aggregate_hash"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": "qa02.auto02/1"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "handoff_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "node_hash": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifact": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "file_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "provenance_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "project_id",
        "task_id",
        "version",
        "artifact",
        "file_hash",
        "bytes",
        "path",
        "provenance_hash"
      ],
      "additionalProperties": false
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCLEAR",
        "BLOCKED"
      ]
    },
    "action": {
      "enum": [
        "NONE",
        "REWORK",
        "COLLECT_EVIDENCE",
        "ESCALATE"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "failures": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "local",
              "independent",
              "auditor"
            ]
          },
          "criterion_id": {
            "type": "string",
            "pattern": "^Q[0-9]{2}$"
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "FAIL",
              "UNCLEAR",
              "BLOCKED"
            ]
          },
          "evidence_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "criterion_id",
          "requirement_id",
          "code",
          "status",
          "evidence_hash"
        ],
        "additionalProperties": false
      }
    },
    "repair": {
      "type": "object",
      "properties": {
        "attempts_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "next_attempt": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "remaining_budget_micros": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "only_affected_task": {
          "const": true
        },
        "requires_new_artifact_version": {
          "const": true
        },
        "requires_full_recheck": {
          "const": true
        }
      },
      "required": [
        "attempts_used",
        "max_attempts",
        "next_attempt",
        "deadline",
        "remaining_budget_micros",
        "only_affected_task",
        "requires_new_artifact_version",
        "requires_full_recheck"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "authority": {
          "const": "CANDIDATE_ONLY"
        },
        "requires_existing_d08_gate": {
          "const": true
        },
        "requires_current_d03_cas": {
          "const": true
        },
        "physical_decision": {
          "const": "DENY"
        }
      },
      "required": [
        "authority",
        "requires_existing_d08_gate",
        "requires_current_d03_cas",
        "physical_decision"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "scope",
    "spec",
    "handoff_hash",
    "plan_hash",
    "node_hash",
    "node_id",
    "expected_revision",
    "fence",
    "artifact",
    "profile_hash",
    "evidence_hash",
    "verdict",
    "action",
    "code",
    "failures",
    "repair",
    "trust",
    "idempotency_key"
  ],
  "additionalProperties": false
}
