{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/contracts/v1/spec-revision.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "spec-revision"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^evt_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "epochs": {
      "$ref": "common.schema.json#/$defs/epochs"
    },
    "spec": {
      "$ref": "common.schema.json#/$defs/spec"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^reqmt_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
        "maxLength": 72
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "norms": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/norm"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/spec"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "contract",
    "request_id",
    "correlation_id",
    "causation_id",
    "actor",
    "scope",
    "epochs",
    "spec",
    "created_at",
    "expected_revision",
    "status",
    "requirements",
    "norms",
    "supersedes"
  ],
  "additionalProperties": false
}
