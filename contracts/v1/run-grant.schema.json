{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/contracts/v1/run-grant.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "run-grant"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^evt_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "epochs": {
      "$ref": "common.schema.json#/$defs/epochs"
    },
    "spec": {
      "$ref": "common.schema.json#/$defs/spec"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "parent_run_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^run_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tool_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
        "maxLength": 72
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "budget_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "max_children": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "max_physical_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    }
  },
  "required": [
    "schema_version",
    "contract",
    "request_id",
    "correlation_id",
    "causation_id",
    "actor",
    "scope",
    "epochs",
    "spec",
    "created_at",
    "expected_revision",
    "run_id",
    "parent_run_id",
    "capabilities",
    "deadline",
    "budget_ref",
    "config_hash",
    "manifest_hash",
    "depth",
    "max_children",
    "max_physical_attempts"
  ],
  "additionalProperties": false
}
