{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/contracts/v1/tool-capability.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "tool-capability"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^evt_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "epochs": {
      "$ref": "common.schema.json#/$defs/epochs"
    },
    "spec": {
      "$ref": "common.schema.json#/$defs/spec"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tool_id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$(?![\\s\\S])"
    },
    "tool_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "input_schema_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "output_schema_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "effect_class": {
      "enum": [
        "READ_ONLY",
        "IDEMPOTENT_WRITE",
        "NON_IDEMPOTENT"
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "network_scope": {
      "const": "NONE"
    },
    "credential_handle": {
      "type": "null"
    },
    "retry_eligible": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "contract",
    "request_id",
    "correlation_id",
    "causation_id",
    "actor",
    "scope",
    "epochs",
    "spec",
    "created_at",
    "expected_revision",
    "tool_id",
    "tool_version",
    "tool_digest",
    "input_schema_hash",
    "output_schema_hash",
    "effect_class",
    "timeout_ms",
    "max_output_bytes",
    "network_scope",
    "credential_handle",
    "retry_eligible"
  ],
  "additionalProperties": false
}
