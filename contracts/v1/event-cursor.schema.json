{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/contracts/v1/event-cursor.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "event-cursor"
    },
    "recipient": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "stream_id": {
      "type": "string",
      "pattern": "^stream_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochs": {
      "$ref": "common.schema.json#/$defs/epochs"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "contract",
    "recipient",
    "project_id",
    "stream_id",
    "last_sequence",
    "epochs",
    "expires_at"
  ],
  "additionalProperties": false
}
