{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awe.invalid/contracts/v1/owner-action.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract": {
      "const": "owner-action"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^evt_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "maxLength": 72
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "epochs": {
      "$ref": "common.schema.json#/$defs/epochs"
    },
    "spec": {
      "$ref": "common.schema.json#/$defs/spec"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner_action_id": {
      "type": "string",
      "pattern": "^oa_[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])",
      "maxLength": 72
    },
    "status": {
      "enum": [
        "OPEN",
        "SUBMITTED",
        "VERIFYING",
        "VERIFIED",
        "REJECTED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "action": {
      "enum": [
        "inventory",
        "connection-test",
        "reconcile",
        "scope-review"
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "uses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "revoked_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_receipt": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "contract",
    "request_id",
    "correlation_id",
    "causation_id",
    "actor",
    "scope",
    "epochs",
    "spec",
    "created_at",
    "expected_revision",
    "owner_action_id",
    "status",
    "action",
    "resource",
    "payload_hash",
    "expires_at",
    "max_uses",
    "uses",
    "revoked_at",
    "verification_receipt"
  ],
  "additionalProperties": false
}
